# Optional Overrides — Leave blank for automatic GCP project & Vertex AI permission discovery!
# The backend automatically probes Application Default Credentials (ADC), Cloud Resource Manager
# `testIamPermissions`, and accessible gcloud projects to select:
#   1. `enterprise_interactions` (`genai.Client(enterprise=True)`) if `aiplatform.interactions.create` is granted
#   2. `vertex_standard` (`genai.Client(vertexai=True)`) if `aiplatform.endpoints.predict` is granted
#   3. `api_key` if `GEMINI_API_KEY` is provided below

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET_NAME=
GEMINI_API_KEY=

# Optional model overrides
IMAGE_MODEL=gemini-3.1-flash-image
JUDGE_MODEL=gemini-3.8-flash
